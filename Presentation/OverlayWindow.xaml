<Window x:Class="EousGate.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EousGate 打开面板预览"
        WindowStyle="None" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True" AllowDrop="True"
        Width="404" MinHeight="0" MaxHeight="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="Manual" FontFamily="Segoe UI Variable Text">
  <Border x:Name="PanelCard"
          Background="{DynamicResource PanelElevatedSurface}"
          BorderBrush="{DynamicResource PanelBorder}"
          BorderThickness="1"
          CornerRadius="8"
          Effect="{DynamicResource PanelShadow}"
          ClipToBounds="True"
          RenderTransformOrigin="0,0.5">
    <Border.RenderTransform>
      <TransformGroup>
        <TranslateTransform x:Name="PanelTranslation" X="-28" />
        <ScaleTransform x:Name="PanelScale" ScaleX="0.96" ScaleY="0.96" />
      </TransformGroup>
    </Border.RenderTransform>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="3"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="AccentRail" Grid.Row="0" Background="{DynamicResource PanelAccent}">
        <Grid x:Name="AccentSegments">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#2F6FED"/>
          <Border Grid.Column="1" Background="#00A6A6"/>
          <Border Grid.Column="2" Background="#72C472"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="18,16,18,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                Background="{DynamicResource PanelAccentSoft}">
          <TextBlock x:Name="FileTypeMark" Text="FILE" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource PanelAccent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock x:Name="Heading" Text="选择打开文件的软件" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource PanelForeground}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="FileContext" Text="本机应用" Margin="0,3,0,0" FontSize="12"
                     Foreground="{DynamicResource PanelMutedForeground}" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
        <Border Grid.Column="3" Padding="8,4" CornerRadius="10"
                Background="{DynamicResource PanelSurfaceSoft}" VerticalAlignment="Center">
          <TextBlock x:Name="CandidateCountLabel" Text="0 个" FontSize="11"
                     Foreground="{DynamicResource PanelMutedForeground}"/>
        </Border>
      </Grid>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    MaxHeight="430" CanContentScroll="False" Padding="12,0,12,12">
        <Grid x:Name="CandidatesHost" />
      </ScrollViewer>

      <Border Grid.Row="3" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0"
              Background="{DynamicResource PanelSurfaceSoft}" Padding="14,11">
        <Grid x:Name="Actions">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
