<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="WorkbenchButton" TargetType="Button" BasedOn="{StaticResource FluentAButton}"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="13,0"/><Setter Property="Background" Value="{DynamicResource PanelSurfaceSoft}"/></Style>
 <Style x:Key="WorkbenchPrimary" TargetType="Button" BasedOn="{StaticResource WorkbenchButton}"><Setter Property="Background" Value="{DynamicResource PanelAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelAccent}"/><Setter Property="Foreground" Value="{DynamicResource PanelOnAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="WorkbenchIconButton" TargetType="Button" BasedOn="{StaticResource WorkbenchButton}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="17"/><Setter Property="Foreground" Value="{DynamicResource PanelMutedForeground}"/></Style>
 <Style x:Key="WorkbenchCheckBox" TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{DynamicResource PanelFocusVisualStyle}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Box" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource PanelMutedForeground}" Background="{DynamicResource PanelBackground}"><Path x:Name="Tick" Data="M3,8 L7,12 14,4" Stroke="{DynamicResource PanelOnAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"/></Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource PanelSuccess}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PanelSuccess}"/><Setter TargetName="Tick" Property="Opacity" Value="1"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PanelSuccess}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WorkbenchState" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource PanelMutedForeground}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Foreground" Value="{DynamicResource PanelSuccess}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource PanelDanger}"/></DataTrigger></Style.Triggers></Style>
 <Style x:Key="WorkbenchTextBox" TargetType="TextBox">
  <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{DynamicResource PanelFocusVisualStyle}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Input" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="{DynamicResource PanelFocusRing}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Input" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WorkbenchExpander" TargetType="Expander">
  <Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
   <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" FocusVisualStyle="{DynamicResource PanelFocusVisualStyle}">
    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent" MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="Arrow" Data="M2,5 L7,10 12,5" Width="14" Height="14" Stroke="{DynamicResource PanelMutedForeground}" StrokeThickness="1.5" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
   </ToggleButton><ContentPresenter x:Name="Body" Visibility="Collapsed" ContentSource="Content"/>
  </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WorkbenchFlatList" TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>

 <Style x:Key="WorkbenchTextButton" TargetType="Button" BasedOn="{StaticResource WorkbenchButton}"><Setter Property="Content" Value="设置"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="5,0"/><Setter Property="Height" Value="34"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource PanelMutedForeground}"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Descriptor.Kind}" Value="External"/><Condition Binding="{Binding State}" Value="Failed"/><Condition Binding="{Binding CanStart}" Value="False"/><Condition Binding="{Binding CanStop}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Content" Value="设置路径"/><Setter Property="Foreground" Value="{DynamicResource PanelAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></MultiDataTrigger></Style.Triggers></Style>
 <Style x:Key="WorkbenchNavButton" TargetType="Button" BasedOn="{StaticResource WorkbenchButton}"><Setter Property="Height" Value="41"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource PanelMutedForeground}"/></Style>
 <Style x:Key="WorkbenchNavGlyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <ControlTemplate x:Key="WorkbenchContentTabs" TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource PanelForeground}" TextElement.FontWeight="Normal"/></ControlTemplate>
 <ControlTemplate x:Key="WorkbenchFileTabs" TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel x:Name="FileTabHeaders" Orientation="Horizontal" HorizontalAlignment="Left" IsItemsHost="True" Margin="24,12,24,0"/><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource PanelForeground}" TextElement.FontWeight="Normal"/></Grid></ControlTemplate>

 <Style x:Key="WorkbenchTabItem" TargetType="TabItem"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Foreground" Value="{DynamicResource PanelMutedForeground}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource PanelFocusVisualStyle}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="TabHeader" ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource PanelSelection}"/><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource PanelFocusRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
