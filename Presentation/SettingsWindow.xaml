<Window x:Class="EousGate.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EousGate 设置中心" Width="960" Height="780" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PanelBackground}"
        Foreground="{DynamicResource PanelForeground}" FontFamily="Segoe UI Variable Text">
  <Window.Resources>
    <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="18"/><Setter Property="Foreground" Value="{DynamicResource PanelMutedForeground}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="GroupTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource PanelMutedForeground}"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="SettingsTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="{DynamicResource PanelSurfaceSoft}"/><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="{DynamicResource PanelFocusRing}"/><Setter TargetName="Input" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Input" Property="Opacity" Value="0.48"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBox}"/>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="150"/><Setter Property="Padding" Value="10,5"/><Setter Property="Background" Value="{DynamicResource PanelSurfaceSoft}"/><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/><Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisualStyle}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PanelFocusRing}"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisualStyle}"/></Style>
    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}"><Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="78"/><Setter Property="Background" Value="{DynamicResource PanelSurfaceSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/><Setter Property="Foreground" Value="{DynamicResource PanelForeground}"/></Style>
    <Style x:Key="TabItemStyle" TargetType="TabItem">
      <Setter Property="Width" Value="178"/><Setter Property="MinHeight" Value="48"/><Setter Property="Margin" Value="8,2"/><Setter Property="Padding" Value="14,8"/><Setter Property="Foreground" Value="{DynamicResource PanelMutedForeground}"/><Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Indicator" CornerRadius="2" Margin="0,3,12,3"/><ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelSurfaceSoft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelAccentSoft}"/><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource PanelAccent}"/><Setter Property="Foreground" Value="{DynamicResource PanelAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PanelFocusRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChoiceCard" TargetType="ListBoxItem">
      <Setter Property="Width" Value="246"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisualStyle}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{DynamicResource PanelElevatedSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelSurfaceSoft}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelAccentSoft}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CandidateRow" TargetType="ListBoxItem"><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource PanelFocusVisualStyle}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelSurfaceSoft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelAccentSoft}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>

  <Grid x:Name="WindowRoot" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><TranslateTransform x:Name="WindowTranslation" Y="10"/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1"><Grid Margin="30,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="设置中心" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="面板外观、触发方式与软件选项" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Width="40" Height="40" CornerRadius="9" Background="{DynamicResource PanelAccentSoft}" VerticalAlignment="Center"><TextBlock Text="EG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PanelAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>

    <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="18,12,18,0" Background="Transparent" BorderThickness="0" TabStripPlacement="Left" ItemContainerStyle="{StaticResource TabItemStyle}">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0" CornerRadius="8,0,0,8"><StackPanel><StackPanel Margin="18,18,14,12"><TextBlock Text="设置" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PanelMutedForeground}"/><TextBlock Text="EousGate" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Local"/></StackPanel></Border><Border Grid.Column="1" Margin="20,0,0,0"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></TabControl.Template>

      <TabItem Header="面板外观"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,12,12,24">
        <TextBlock Text="面板外观" Style="{StaticResource PageTitle}"/><TextBlock Text="选择打开面板的布局、材质、主题与阅读体验。" Style="{StaticResource Caption}" Margin="0,5,0,18"/>
        <TextBlock Text="打开面板设计" Style="{StaticResource GroupTitle}"/><TextBlock Text="三种布局共享相同的拖拽和打开行为。" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
        <ListBox x:Name="DesignSchemes" SelectedValuePath="Id" ItemContainerStyle="{StaticResource ChoiceCard}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel><Border Height="68" Background="{DynamicResource PanelSurfaceSoft}" CornerRadius="6" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#2F6FED"/><Border Grid.Column="1" Background="#00A6A6"/><Border Grid.Column="2" Background="#72C472"/></Grid><StackPanel Grid.Row="1" Margin="0,8,0,0"><Border Height="12" Background="{DynamicResource PanelElevatedSurface}" CornerRadius="3"/><Border Height="12" Margin="0,5,0,0" Background="{DynamicResource PanelElevatedSurface}" CornerRadius="3"/></StackPanel></Grid></Border><TextBlock Text="{Binding Sequence}" FontSize="11" Foreground="{DynamicResource PanelAccent}" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,6,0,0"><StackPanel><TextBlock Text="主题与动效" Style="{StaticResource GroupTitle}"/><TextBlock Text="更改会同步应用到打开面板和设置中心。" Style="{StaticResource Caption}" Margin="0,4,0,12"/><WrapPanel><StackPanel Width="190" Margin="0,0,18,10"><TextBlock Text="主题" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Theme"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox></StackPanel><StackPanel Width="190" Margin="0,0,18,10"><TextBlock Text="动效时长（毫秒）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AnimationDuration"/></StackPanel></WrapPanel><CheckBox x:Name="LargeText" Content="使用较大的面板文字和图标"/><CheckBox x:Name="EdgePulseEnabled" Content="拖拽时显示边缘脉冲动效" Margin="0"/></StackPanel></Border>
        <TextBlock Text="皮肤材质" Style="{StaticResource GroupTitle}" Margin="0,20,0,0"/><TextBlock Text="高对比度模式会自动使用系统颜色。" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
        <ListBox x:Name="Skins" SelectedValuePath="Id" ItemContainerStyle="{StaticResource ChoiceCard}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel><Border Height="48" CornerRadius="6" Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"><Grid Margin="9"><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource PanelAccent}" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><Border Height="8" Background="{DynamicResource PanelElevatedSurface}" CornerRadius="3"/><Border Height="8" Width="90" HorizontalAlignment="Left" Margin="0,7,0,0" Background="{DynamicResource PanelAccentSoft}" CornerRadius="3"/></StackPanel></Grid></Border><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </StackPanel></ScrollViewer></TabItem>

      <TabItem Header="触发与接收"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,12,12,24">
        <TextBlock Text="触发与接收" Style="{StaticResource PageTitle}"/><TextBlock Text="配置各边缘接收条、触发节奏和面板尺寸。" Style="{StaticResource Caption}" Margin="0,5,0,18"/>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="接收条尺寸" Style="{StaticResource GroupTitle}"/><TextBlock Text="每一侧独立设置覆盖长度、宽度和偏移。" Style="{StaticResource Caption}" Margin="0,4,0,14"/><UniformGrid Columns="3">
          <StackPanel Margin="0,0,16,0"><TextBlock Text="左侧" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="长度 %" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LeftBandLength" ToolTip="10 到 100"/><TextBlock Text="宽度 %" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="LeftBandWidth" ToolTip="0.1 到 5"/><TextBlock Text="偏移 px" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="LeftBandOffset" ToolTip="-10000 到 10000"/></StackPanel>
          <StackPanel Margin="8,0"><TextBlock Text="右侧" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="长度 %" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RightBandLength" ToolTip="10 到 100"/><TextBlock Text="宽度 %" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="RightBandWidth" ToolTip="0.1 到 5"/><TextBlock Text="偏移 px" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="RightBandOffset" ToolTip="-10000 到 10000"/></StackPanel>
          <StackPanel Margin="16,0,0,0"><TextBlock Text="上侧" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="长度 %" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TopBandLength" ToolTip="10 到 100"/><TextBlock Text="宽度 %" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="TopBandWidth" ToolTip="0.1 到 5"/><TextBlock Text="偏移 px" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="TopBandOffset" ToolTip="-10000 到 10000"/></StackPanel>
        </UniformGrid></StackPanel></Border>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="接收条外观与位置" Style="{StaticResource GroupTitle}"/><WrapPanel Margin="0,12,0,0"><StackPanel Width="180" Margin="0,0,18,10"><TextBlock Text="透明度" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BandOpacity" ToolTip="0.05 到 1"/></StackPanel><StackPanel Width="230"><TextBlock Text="颜色" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><Border x:Name="BandColorPreview" Width="44" Height="30" CornerRadius="6" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Margin="0,0,8,0"/><Button x:Name="ChooseColorButton" Content="选择颜色" Click="ChooseColorClick" Width="96" Margin="0"/></StackPanel></StackPanel></WrapPanel><TextBlock Text="启用位置" Style="{StaticResource FieldLabel}"/><WrapPanel x:Name="EdgeBandPositions"><CheckBox x:Name="EdgeBandLeft" Content="左侧" Margin="0,0,18,0"/><CheckBox x:Name="EdgeBandRight" Content="右侧" Margin="0,0,18,0"/><CheckBox x:Name="EdgeBandTop" Content="上侧" Margin="0"/></WrapPanel></StackPanel></Border>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="触发与面板参数" Style="{StaticResource GroupTitle}"/><TextBlock Text="输入范围会在应用或保存时校验。" Style="{StaticResource Caption}" Margin="0,4,0,12"/><WrapPanel>
          <StackPanel Width="190" Margin="0,0,18,12"><TextBlock Text="默认显示数量" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CandidateCount"/></StackPanel><StackPanel Width="190" Margin="0,0,18,12"><TextBlock Text="触发延迟（毫秒）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TriggerDelay"/></StackPanel><StackPanel Width="190" Margin="0,0,18,12"><TextBlock Text="自动收起（毫秒）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AutoDismissDelay" ToolTip="0 到 10000；0 表示立即收起"/></StackPanel><StackPanel Width="190" Margin="0,0,18,12"><TextBlock Text="面板宽度" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PanelWidth"/></StackPanel><StackPanel Width="190" Margin="0,0,18,0"><TextBlock Text="面板最大高度" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PanelMaxHeight"/></StackPanel><StackPanel Width="190" Margin="0,0,18,0"><TextBlock Text="候选间距" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CandidateGap"/></StackPanel>
        </WrapPanel></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>

      <TabItem Header="剪贴板链接"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,12,12,24">
        <TextBlock Text="剪贴板链接" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="复制含网页链接的文本，在屏幕侧边一键打开。" Style="{StaticResource Caption}" Margin="0,5,0,18"/>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel>
          <CheckBox x:Name="ClipboardEnabled" Content="检测剪贴板中的网页链接" Margin="0,0,0,8"/>
          <TextBlock Text="支持 http://、https:// 和 www. 开头的链接。重复复制相同内容，也会重新弹出并开始计时。" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,18,0,0">
            <StackPanel Width="190" Margin="0,0,18,12">
              <Label Content="停留时间（秒）" Target="{Binding ElementName=ClipboardDuration}" Padding="0,0,0,5"/>
              <TextBox x:Name="ClipboardDuration" ToolTip="2 到 60 秒，默认 5 秒" AutomationProperties.Name="剪贴板提示停留时间（秒）"/>
              <TextBlock Text="2–60 秒，默认 5 秒" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Width="190" Margin="0,0,0,12">
              <Label Content="弹出位置" Target="{Binding ElementName=ClipboardSide}" Padding="0,0,0,5"/>
              <ComboBox x:Name="ClipboardSide" AutomationProperties.Name="剪贴板提示弹出位置"><ComboBoxItem Content="右侧" Tag="Right"/><ComboBoxItem Content="左侧" Tag="Left"/></ComboBox>
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="鼠标移入或使用键盘操作时暂停计时。点击链接后收起；也可点击关闭或按 Esc。" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0"><StackPanel>
          <TextBlock Text="仅在本机检测" Style="{StaticResource GroupTitle}"/>
          <TextBlock Text="不保存剪贴板历史，不记录文本或网址。只有点击链接时才交给默认浏览器打开。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>

      <TabItem Header="软件选项"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,12,12,24">
        <TextBlock Text="软件选项" Style="{StaticResource PageTitle}"/><TextBlock Text="按文件类型维护候选软件的显示、隐藏和顺序。" Style="{StaticResource Caption}" Margin="0,5,0,18"/>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="载入文件类型" Style="{StaticResource GroupTitle}"/><TextBlock Text="输入扩展名后载入对应的软件选项。" Style="{StaticResource Caption}" Margin="0,4,0,10"/><WrapPanel><TextBox x:Name="Extension" Width="150" Margin="0,0,8,8" ToolTip="例如 .txt"/><Button Content="加载" Click="LoadClick" Width="76" Margin="0,0,8,8"/><Button x:Name="AddAppButton" Content="添加应用" Click="AddAppClick" Width="96" Margin="0,0,0,8" IsEnabled="False"/></WrapPanel></StackPanel></Border>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="候选软件" Style="{StaticResource GroupTitle}"/><TextBlock Text="取消勾选可隐藏候选；选择一项后可调整顺序。" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="LoadedLabel" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource PanelMutedForeground}" TextWrapping="Wrap" Margin="14,0,0,0"/></Grid><ListBox x:Name="Apps" Height="250" Margin="0,12,0,10" Background="{DynamicResource PanelElevatedSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" ItemContainerStyle="{StaticResource CandidateRow}" SelectionChanged="AppsSelectionChanged"/><WrapPanel><Button Content="上移" Click="MoveUpClick" Width="76" Margin="0,0,8,8"/><Button Content="下移" Click="MoveDownClick" Width="76" Margin="0,0,8,8"/><Button x:Name="RemoveCustomButton" Content="删除自定义" Click="RemoveCustomClick" Width="104" Margin="0,0,0,8" IsEnabled="False"/></WrapPanel></StackPanel></Border>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="当前文件类型覆盖" Style="{StaticResource GroupTitle}"/><CheckBox x:Name="PerTypeCountEnabled" Content="为当前文件类型单独设置显示数量" Margin="0,10,0,6"/><TextBox x:Name="PerTypeCount" Width="150" HorizontalAlignment="Left" IsEnabled="False"/></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>

      <TabItem Header="辅助与隐私"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,12,12,24">
        <TextBlock Text="辅助与隐私" Style="{StaticResource PageTitle}"/><TextBlock Text="管理本地诊断，并查看软件运行边界。" Style="{StaticResource Caption}" Margin="0,5,0,18"/>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="本地诊断" Style="{StaticResource GroupTitle}"/><TextBlock Text="日志只记录固定事件名，不记录文件名、路径或文件内容。" Style="{StaticResource Caption}" Margin="0,4,0,10"/><CheckBox x:Name="Diagnostics" Content="启用本地诊断日志" Margin="0"/></StackPanel></Border>
        <Border Background="{DynamicResource PanelSurfaceSoft}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0"><StackPanel><TextBlock Text="关于 EousGate" Style="{StaticResource GroupTitle}"/><TextBlock Text="EousGate 0.1.0" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="绿色免安装，仅在本机运行；不会修改 Windows 默认文件关联。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelSurfaceSoft}"><Grid Margin="24,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="恢复默认" Click="ResetClick" Width="92" Margin="0"/><Button Grid.Column="1" Content="帮助" Click="HelpClick" Width="72" Margin="10,0,0,0" HorizontalAlignment="Left"/><Button Grid.Column="2" Content="取消" Click="CancelClick" Style="{StaticResource SecondaryActionButtonStyle}" Width="86"/><TextBlock x:Name="ApplyStatusText" Grid.Column="3" Foreground="{DynamicResource PanelSuccess}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Grid.Column="4" Content="应用" Click="ApplyClick" Width="86" Margin="0,0,8,0"/><Button Grid.Column="5" Content="保存" Click="SaveClick" Style="{StaticResource PrimaryActionButtonStyle}" Width="92"/></Grid></Border>
    <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ChooseColorButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource PanelElevatedSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Effect="{DynamicResource PanelShadow}"><StackPanel><UniformGrid x:Name="ColorSwatches" Columns="6"/><Button Content="自定义颜色…" Click="CustomColorClick" Margin="0,8,0,0"/></StackPanel></Border></Popup>
  </Grid>
</Window>
