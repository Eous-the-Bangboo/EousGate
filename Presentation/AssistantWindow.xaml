<Window x:Class="EousGate.AssistantWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EousGate" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Eous 助手 · EousAssistant" Icon="pack://application:,,,/EousAssistant;component/Assets/EousGate.ico" Width="980" Height="700" MinWidth="900" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="{DynamicResource PanelElevatedSurface}" Foreground="{DynamicResource PanelForeground}" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <local:ProgramIconConverter x:Key="ProgramIcon"/><local:ToolDescriptionConverter x:Key="ToolDescription"/><Style TargetType="Button" BasedOn="{StaticResource WorkbenchButton}"/>
  <DataTemplate x:Key="ToolRowTemplate">
   <Border MinHeight="72" BorderBrush="{DynamicResource PanelDivider}" BorderThickness="0,0,0,1" Padding="0,10" Loaded="FluentRowLoaded">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="56"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
     <Grid Width="27" Height="27" HorizontalAlignment="Left" VerticalAlignment="Center"><Image x:Name="ProgramIconImage" Source="{Binding Descriptor.IconPath,Converter={StaticResource ProgramIcon}}" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="{Binding Descriptor.Glyph}" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{DynamicResource PanelSuccess}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source,ElementName=ProgramIconImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><WrapPanel><TextBlock Text="{Binding Descriptor.ChineseName}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Descriptor.EnglishName}" Margin="8,3,0,0" FontSize="13" Foreground="{DynamicResource PanelMutedForeground}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Descriptor.Kind}" Value="External"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></WrapPanel>
      <TextBlock Text="{Binding Descriptor,Converter={StaticResource ToolDescription}}" FontSize="{DynamicResource WorkbenchBodySize}" Foreground="{DynamicResource PanelMutedForeground}" TextWrapping="Wrap" LineHeight="20"/>
      <TextBlock Text="{Binding Error}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource PanelDanger}" LineHeight="20"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource PanelMutedForeground}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Fill" Value="{DynamicResource PanelSuccess}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Fill" Value="{DynamicResource PanelDanger}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding StateText}" Style="{StaticResource WorkbenchState}"/></StackPanel>
     <local:ToolSwitch Grid.Column="3" Tag="{Binding}" State="{Binding State}" CanStart="{Binding CanStart}" CanStop="{Binding CanStop}" AnimationDuration="{DynamicResource ToolSwitchAnimationDuration}" Click="ToolSwitchClick" Style="{StaticResource AppleToolSwitch}" AutomationProperties.Name="{Binding Descriptor.ChineseName,StringFormat={}{0}运行开关}" AutomationProperties.ItemStatus="{Binding StateText}"/>
     <Button Grid.Column="4" Style="{StaticResource WorkbenchTextButton}" Tag="{Binding}" Click="SettingsClick" IsEnabled="{Binding CanOpenSettings}" AutomationProperties.Name="{Binding Descriptor.ChineseName,StringFormat=设置{0}}"/>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12"><Grid x:Name="HomeRoot"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource PanelDivider}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="16,0"><Image Source="{DynamicResource AssistantPortrait}" Width="25" Height="25" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,25,25" RadiusX="12" RadiusY="12"/></Image.Clip></Image><TextBlock Text="Eous 助手" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" Click="MinimizeClick" Style="{StaticResource WorkbenchIconButton}" Width="38" Height="30" FontSize="10" AutomationProperties.Name="最小化"/><Button Content="&#xE922;" Click="MaximizeClick" Style="{StaticResource WorkbenchIconButton}" Width="38" Height="30" FontSize="10" AutomationProperties.Name="最大化或还原"/><Button Content="&#xE8BB;" Click="ClosePanelClick" Style="{StaticResource WorkbenchIconButton}" Width="38" Height="30" FontSize="10" AutomationProperties.Name="关闭面板" ToolTip="关闭面板，运行中的工具保留"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0"><Grid Margin="14,22,14,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="SidebarNavigation"><Button x:Name="NavOverview" Tag="overview" Click="OverviewClick" Style="{StaticResource WorkbenchNavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" Style="{StaticResource WorkbenchNavGlyph}"/><TextBlock Text="工具总览"/></StackPanel></Button><TextBlock Text="工具设置" Foreground="{DynamicResource PanelMutedForeground}" Margin="12,26,0,12"/>
     <Button x:Name="NavFile" Tag="file-hop" Click="NativeNavigationClick" Style="{StaticResource WorkbenchNavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource WorkbenchNavGlyph}"/><TextBlock Text="文件快开"/></StackPanel></Button>
     <Button x:Name="NavWeb" Tag="web-hop" Click="NativeNavigationClick" Style="{StaticResource WorkbenchNavButton}" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" Style="{StaticResource WorkbenchNavGlyph}"/><TextBlock Text="网页快开"/></StackPanel></Button>
     <Button x:Name="NavFolder" Tag="folder-hop" Click="NativeNavigationClick" Style="{StaticResource WorkbenchNavButton}" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource WorkbenchNavGlyph}"/><TextBlock Text="文件夹快跳"/></StackPanel></Button>
    </StackPanel>
    <Grid x:Name="CharacterScene" Grid.Row="1" ClipToBounds="True" IsHitTestVisible="False" Focusable="False" Margin="-14,10,-14,4"><Border Height="1" Background="{DynamicResource PanelBorder}" VerticalAlignment="Bottom" Margin="26,0,22,8"/><Image x:Name="EousCharacter" Source="pack://application:,,,/EousAssistant;component/Assets/EousCharacter.png" MaxWidth="171" MaxHeight="211" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
    <StackPanel Grid.Row="2"><Button x:Name="NavGeneral" Tag="general" Click="GeneralSettingsClick" Style="{StaticResource WorkbenchNavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource WorkbenchNavGlyph}"/><TextBlock Text="通用设置"/></StackPanel></Button><Button x:Name="NavAbout" Tag="about" Click="AboutClick" Style="{StaticResource WorkbenchNavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource WorkbenchNavGlyph}"/><TextBlock Text="关于 Eous"/></StackPanel></Button></StackPanel>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="25,24,25,0"><Grid.RowDefinitions><RowDefinition Height="67"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="HomeHeading"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HomeTitle" Text="工具总览" FontSize="24" FontWeight="SemiBold"/><StackPanel x:Name="BatchActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="全部启动" Tag="start-all" Click="BatchClick" Style="{StaticResource WorkbenchPrimary}" Margin="0,0,10,0"/><Button Content="全部关闭" Tag="stop-all" Click="BatchClick"/></StackPanel></Grid>
    <ScrollViewer x:Name="ToolArea" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,12"><StackPanel x:Name="NativeHeading" Orientation="Horizontal"><TextBlock Text="Eous原生工具" FontWeight="SemiBold" Foreground="{DynamicResource PanelMutedForeground}"/><TextBlock x:Name="NativeCount" Margin="8,0,0,0" Foreground="{DynamicResource PanelMutedForeground}"/></StackPanel></Border>
     <ItemsControl x:Name="ToolList" ItemTemplate="{StaticResource ToolRowTemplate}"/>
     <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,4" Margin="0,24,0,0"><DockPanel x:Name="ExternalHeading" LastChildFill="False"><TextBlock Text="非Eous原生工具" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PanelMutedForeground}"/><TextBlock x:Name="ExternalCount" Margin="8,0,0,0" Foreground="{DynamicResource PanelMutedForeground}" VerticalAlignment="Center"/><Button x:Name="AddProgramButton" Height="24" DockPanel.Dock="Right" Content="＋ 添加程序" Click="AddProgramClick" Style="{StaticResource WorkbenchTextButton}" Foreground="{DynamicResource PanelAccent}" AutomationProperties.Name="添加监控程序"/></DockPanel></Border>
     <ItemsControl x:Name="ExternalToolList" ItemTemplate="{StaticResource ToolRowTemplate}"/>
    </StackPanel></ScrollViewer>
    <TextBlock x:Name="Feedback" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PanelMutedForeground}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
   </Grid>
  </Grid>
  <Border x:Name="FluentFooter" Grid.Row="2" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="209,0,20,0"><TextBlock Text="ⓘ  关闭面板后，已启动的工具继续运行" Foreground="{DynamicResource PanelMutedForeground}" VerticalAlignment="Center"/></Border>
 </Grid></Border>
</Window>
