<Window x:Class="EousGate.AssistantWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EousGate" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Eous 助手 · EousAssistant" Icon="pack://application:,,,/EousAssistant;component/Assets/EousGate.ico" Width="1000" Height="760" MinWidth="900" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="{DynamicResource PanelElevatedSurface}" Foreground="{DynamicResource PanelForeground}" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="20"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <local:ProgramIconConverter x:Key="ProgramIcon"/><local:ToolDescriptionConverter x:Key="ToolDescription"/><Style TargetType="Button" BasedOn="{StaticResource WorkbenchButton}"/>
  <DataTemplate x:Key="ToolRowTemplate">
   <Border MinHeight="72" BorderBrush="{DynamicResource PanelDivider}" BorderThickness="0,0,0,1" Padding="0,12" Loaded="FluentRowLoaded">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="58"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
     <Border Width="38" Height="38" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource GlassControlSurface}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="0.5">
      <Grid Width="21" Height="21"><Image x:Name="ProgramIconImage" Source="{Binding Descriptor.IconPath,Converter={StaticResource ProgramIcon}}" RenderOptions.BitmapScalingMode="HighQuality"/>
       <TextBlock Text="{Binding Descriptor.Glyph}" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{DynamicResource PanelSuccess}" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source,ElementName=ProgramIconImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
      <TextBlock Text="{Binding Descriptor.ChineseName}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Descriptor,Converter={StaticResource ToolDescription}}" Margin="0,3,0,0" FontSize="{DynamicResource WorkbenchBodySize}" Foreground="{DynamicResource PanelMutedForeground}" TextWrapping="Wrap" LineHeight="19"/>
      <TextBlock Text="{Binding Error}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource PanelDanger}" LineHeight="20"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource PanelMutedForeground}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Fill" Value="{DynamicResource PanelSuccess}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Fill" Value="{DynamicResource PanelDanger}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding StateText}" Style="{StaticResource WorkbenchState}" FontSize="12"/></StackPanel>
     <local:ToolSwitch Grid.Column="3" Tag="{Binding}" State="{Binding State}" CanStart="{Binding CanStart}" CanStop="{Binding CanStop}" AnimationDuration="{DynamicResource ToolSwitchAnimationDuration}" Click="ToolSwitchClick" Style="{StaticResource AppleToolSwitch}" AutomationProperties.Name="{Binding Descriptor.ChineseName,StringFormat={}{0}运行开关}" AutomationProperties.ItemStatus="{Binding StateText}"/>
     <Button Grid.Column="4" Content="&#xE713;" Style="{StaticResource WorkbenchIconButton}" Width="32" Height="34" FontSize="15" Tag="{Binding}" Click="SettingsClick" IsEnabled="{Binding CanOpenSettings}" ToolTip="工具设置" AutomationProperties.Name="{Binding Descriptor.ChineseName,StringFormat=设置{0}}"/>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Border x:Name="GlassShell" Background="{DynamicResource GlassWindowSurface}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1" CornerRadius="20">
  <Grid x:Name="HomeRoot"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource PanelDivider}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="18,0"><Ellipse Fill="{DynamicResource PanelAccent}" Width="7" Height="7" Margin="0,0,9,0"/><TextBlock Text="Eous 助手" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Content="&#xE921;" Click="MinimizeClick" Style="{StaticResource WorkbenchIconButton}" Width="38" Height="30" FontSize="10" AutomationProperties.Name="最小化"/>
     <Button Content="&#xE922;" Click="MaximizeClick" Style="{StaticResource WorkbenchIconButton}" Width="38" Height="30" FontSize="10" AutomationProperties.Name="最大化或还原"/>
     <Button Content="&#xE8BB;" Click="ClosePanelClick" Style="{StaticResource WorkbenchIconButton}" Width="38" Height="30" FontSize="10" AutomationProperties.Name="关闭面板" ToolTip="关闭面板，运行中的工具保留"/>
    </StackPanel>
   </Grid></Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource GlassSidebarSurface}" BorderBrush="{DynamicResource PanelDivider}" BorderThickness="0,0,1,0">
     <Grid Margin="14,26,14,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="12,0,0,28"><TextBlock Text="Eous." FontFamily="Georgia" FontSize="38"/><TextBlock Text="YOUR LITTLE HELPER" FontSize="10" Foreground="{DynamicResource PanelMutedForeground}" Margin="1,3,0,0"/></StackPanel>
      <StackPanel x:Name="SidebarNavigation" Grid.Row="1">
       <Button x:Name="NavOverview" Tag="overview" Click="OverviewClick" Style="{StaticResource WorkbenchNavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" Style="{StaticResource WorkbenchNavGlyph}"/><TextBlock Text="我的工具"/></StackPanel></Button>
       <Button x:Name="NavGeneral" Tag="general" Click="GeneralSettingsClick" Style="{StaticResource WorkbenchNavButton}" Margin="0,7,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource WorkbenchNavGlyph}"/><TextBlock Text="通用设置"/></StackPanel></Button>
       <Button x:Name="NavAbout" Tag="about" Click="AboutClick" Style="{StaticResource WorkbenchNavButton}" Margin="0,7,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource WorkbenchNavGlyph}"/><TextBlock Text="关于"/></StackPanel></Button>
      </StackPanel>
      <Grid x:Name="CharacterScene" Grid.Row="2" ClipToBounds="True" IsHitTestVisible="False" Focusable="False" Margin="-14,18,-14,8"><Image x:Name="EousCharacter" Source="pack://application:,,,/EousAssistant;component/Assets/EousCharacter.png" MaxWidth="190" MaxHeight="245" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
      <TextBlock Grid.Row="3" Text="小小助手，随时待命。" FontSize="11" Foreground="{DynamicResource PanelMutedForeground}" Margin="12,8,0,0"/>
     </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,28,30,16"><Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid x:Name="HomeHeading"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="A LITTLE MORE EASE" FontSize="10" Foreground="{DynamicResource PanelMutedForeground}" Margin="0,0,0,7"/><TextBlock x:Name="HomeTitle" Text="让日常，轻一点。" FontSize="27" FontWeight="Medium"/><TextBlock Text="常用工具，各就各位。" FontSize="12" Foreground="{DynamicResource PanelMutedForeground}" Margin="0,6,0,0"/></StackPanel>
      <StackPanel x:Name="BatchActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,18,0,0"><Button x:Name="BatchButton" Content="全部启动" Tag="start-all" Click="BatchClick" Style="{StaticResource WorkbenchGlassPrimary}"/><Button Content="全部关闭" Tag="stop-all" Click="BatchClick" Style="{StaticResource WorkbenchTextButton}" Margin="8,0,0,0" Padding="8,0"/></StackPanel>
     </Grid>
     <ScrollViewer x:Name="ToolArea" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Grid x:Name="NativeHeading" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="快捷工具" FontSize="12" Foreground="{DynamicResource PanelMutedForeground}"/><TextBlock x:Name="NativeCount" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource PanelMutedForeground}"/></StackPanel><TextBlock Text="内置" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource PanelMutedForeground}"/></Grid>
      <ItemsControl x:Name="ToolList" ItemTemplate="{StaticResource ToolRowTemplate}"/>
      <DockPanel x:Name="ExternalHeading" LastChildFill="False" Margin="0,18,0,4"><TextBlock Text="常用程序" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PanelMutedForeground}"/><TextBlock x:Name="ExternalCount" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource PanelMutedForeground}" VerticalAlignment="Center"/><Button x:Name="AddProgramButton" Height="30" DockPanel.Dock="Right" Content="＋ 添加程序" Click="AddProgramClick" Style="{StaticResource WorkbenchTextButton}" Foreground="{DynamicResource PanelAccent}" AutomationProperties.Name="添加监控程序"/></DockPanel>
      <ItemsControl x:Name="ExternalToolList" ItemTemplate="{StaticResource ToolRowTemplate}"/>
     </StackPanel></ScrollViewer>
     <TextBlock x:Name="Feedback" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PanelMutedForeground}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
   </Grid>
   <Border x:Name="FluentFooter" Grid.Row="2" BorderBrush="{DynamicResource PanelDivider}" BorderThickness="0,1,0,0" Background="{DynamicResource GlassFooterSurface}" CornerRadius="0,0,20,20" Padding="18,0"><Grid><TextBlock x:Name="FooterStatus" FontSize="12" Foreground="{DynamicResource PanelMutedForeground}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="关闭面板后，已启动的工具继续运行" FontSize="11" Foreground="{DynamicResource PanelMutedForeground}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border>
  </Grid>
 </Border>
</Window>
