<Window x:Class="EousGate.ClipboardLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EousGate 剪贴板链接" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        Width="380" SizeToContent="Height" FontFamily="Segoe UI Variable Text"
        Foreground="{DynamicResource PanelForeground}" PreviewKeyDown="WindowKeyDown">
  <Border x:Name="Card" Margin="12" Padding="0" CornerRadius="8"
          Background="{DynamicResource PanelElevatedSurface}" BorderBrush="{DynamicResource PanelBorder}"
          BorderThickness="1" Effect="{DynamicResource PanelShadow}">
    <Border.RenderTransform><TranslateTransform x:Name="Slide"/></Border.RenderTransform>
    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
      <Border Height="3" Background="{DynamicResource PanelAccent}" CornerRadius="8,8,0,0"/>
      <Grid Margin="16,12,10,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="剪贴板中的网页" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="Subtitle" Text="点击链接，用默认浏览器打开" FontSize="12" Margin="0,4,0,0"
                     Foreground="{DynamicResource PanelMutedForeground}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="×" Width="32" Height="32" Margin="8,0,0,0" FontSize="20"
                ToolTip="关闭提示" AutomationProperties.Name="关闭链接提示" Click="DismissClick"/>
      </Grid>
      <ScrollViewer x:Name="LinkScroller" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,0,12,4">
        <ItemsControl x:Name="Links">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Click="OpenLinkClick" Tag="{Binding}" Margin="0,0,0,8" Padding="12,10"
                      HorizontalContentAlignment="Stretch" MinHeight="62" ToolTip="{Binding AbsoluteUri}"
                      AutomationProperties.Name="{Binding AbsoluteUri}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding IdnHost}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AbsoluteUri}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PanelMutedForeground}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="↗" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right"
                             Foreground="{DynamicResource PanelAccent}"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="16,0,16,8" FontSize="12"
                 Foreground="{DynamicResource PanelDanger}" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="Countdown" FontSize="12" Margin="16,0,16,14" Foreground="{DynamicResource PanelMutedForeground}"/>
    </StackPanel>
  </Border>
</Window>
