<Window x:Class="EousGate.CustomAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加打开方式" Width="560" Height="390" MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PanelBackground}"
        Foreground="{DynamicResource PanelForeground}" FontFamily="Segoe UI Variable Text">
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource PanelAccentSoft}" VerticalAlignment="Top">
        <TextBlock Text="EG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PanelAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0">
        <TextBlock Text="添加打开方式" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="为当前文件类型添加一个仅在 EousGate 中使用的软件。" Foreground="{DynamicResource PanelMutedForeground}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,24,0,18">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="76"/><RowDefinition Height="76"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="应用路径" VerticalAlignment="Center" Foreground="{DynamicResource PanelMutedForeground}" FontWeight="SemiBold"/>
      <TextBox x:Name="ExecutablePath" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="可执行文件路径"/>
      <TextBlock Text="显示名称" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
      <TextBox x:Name="DisplayName" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" ToolTip="候选列表中显示的名称"/>
      <TextBlock Text="启动参数" Grid.Row="2" VerticalAlignment="Center" Foreground="{DynamicResource PanelMutedForeground}" FontWeight="SemiBold"/>
      <TextBox x:Name="Arguments" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" ToolTip="可选；文件路径会自动作为第一个参数传入"/>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Click="CancelClick" Width="84" Style="{StaticResource SecondaryActionButtonStyle}"/>
        <Button Content="添加" Click="AddClick" Width="84" Style="{StaticResource PrimaryActionButtonStyle}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
