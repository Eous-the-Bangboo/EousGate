<UserControl x:Class="EousGate.AppearancePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" Focusable="False" IsHitTestVisible="False">
  <UserControl.Resources>
    <DataTemplate x:Key="FluentPreviewRow"><Border x:Name="Row" Height="{DynamicResource CandidateRowHeight}" CornerRadius="12" Margin="0,0,0,4" Padding="12,6" BorderBrush="Transparent" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{DynamicResource PanelAccent}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PanelForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource PanelAccent}" VerticalAlignment="Center"/></Grid></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelAccentSoft}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
  </UserControl.Resources>
  <Border Background="{DynamicResource PanelElevatedSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <StackPanel>
      <Border Height="3" Background="{DynamicResource PanelAccent}"/>
      <Grid x:Name="PreviewHeader" Margin="16,16,16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="PreviewBadge" Background="{DynamicResource PanelAccentSoft}" Width="30" Height="34" CornerRadius="12"><TextBlock Text="TXT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PanelAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel x:Name="PreviewLabels" Grid.Column="1"><TextBlock x:Name="PreviewHeading" Text="打开面板" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PanelForeground}"/><TextBlock x:Name="PreviewContext" Text="2 个 TXT 文件" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource PanelMutedForeground}"/></StackPanel>
        <Border x:Name="PreviewCount" Visibility="Collapsed" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,6" CornerRadius="12" Background="{DynamicResource PanelSurfaceSoft}"><TextBlock Text="4 个" FontSize="11" Foreground="{DynamicResource PanelMutedForeground}"/></Border>
      </Grid>
      <ItemsControl x:Name="Rows" Margin="8,0,8,8">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border x:Name="Row" Height="{DynamicResource CandidateRowHeight}" CornerRadius="12" Margin="0,0,0,4" Padding="10,6" BorderBrush="Transparent" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="{DynamicResource PanelAccent}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource PanelForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,4,0"/>
              <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{DynamicResource PanelMutedForeground}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelAccentSoft}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource PanelAccent}"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border x:Name="PreviewFooter" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelSurfaceSoft}" Padding="12"><Grid><TextBlock Text="松开以打开" FontSize="12" Foreground="{DynamicResource PanelMutedForeground}"/><TextBlock Text="Esc 取消" FontSize="12" Foreground="{DynamicResource PanelMutedForeground}" HorizontalAlignment="Right"/></Grid></Border>
    </StackPanel>
  </Border>
</UserControl>
