<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EousAssistant</AssemblyName>
    <RootNamespace>EousGate</RootNamespace>
    <Version>0.2.0-beta.15.4</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.19</FileVersion>
    <InformationalVersion>0.2.0-beta.15.4</InformationalVersion>
    <Authors>Eous-the-Bangboo</Authors>
    <Product>EousAssistant · Eous 助手</Product>
    <Description>Windows desktop assistant with native tools and external program monitoring and control.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\EousGate.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\EousGate.ico" />
    <Resource Include="Assets\EousPortrait-*.png" />
    <Resource Include="Assets\EousCharacter.png" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove=".tmp-build4\**" />
    <EmbeddedResource Remove=".tmp-build4\**" />
    <None Remove=".tmp-build4\**" />
  </ItemGroup>
</Project>
