<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EousGate</AssemblyName>
    <RootNamespace>EousGate</RootNamespace>
    <Version>0.1.0-beta.2</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.1</FileVersion>
    <InformationalVersion>0.1.0-beta.2</InformationalVersion>
    <Authors>Eous-the-Bangboo</Authors>
    <Product>EousGate</Product>
    <Description>Drag files to a screen edge and choose an app to open them.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\EousGate.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove=".tmp-build4\**" />
    <EmbeddedResource Remove=".tmp-build4\**" />
    <None Remove=".tmp-build4\**" />
  </ItemGroup>
</Project>
